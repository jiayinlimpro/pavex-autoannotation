# =============================================================
# .gitignore for pavex-autoannotation
# Files matching these patterns are never tracked or uploaded.
# =============================================================

# ---------- Model weights (too large for GitHub) ----------
# SAM ViT-H is ~2.4 GB; download it from Meta instead.
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
models/

# ---------- Archives ----------
# The seed pack zip contains the model weights.
*.zip
*.tar
*.tar.gz
*.7z
*.tmp

# ---------- Datasets (live in Google Drive / local disk) ----------
# Image licenses belong to the original Kaggle sources.
# Leading "/" = only the repo's top level, so docs/images/ (README pictures) stays tracked.
/BigDataset/
/data/
/images/
/augmented/
/labels_gt/

# ---------- Generated pipeline outputs ----------
runs*/
labels_pred_seg/
overlays_all_seg/
overlays_seg_eval/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---------- Virtual environments ----------
.venv/
venv/
env/

# ---------- Jupyter / Colab ----------
.ipynb_checkpoints/

# ---------- Personal settings ----------
configs/paths.local.json

# ---------- Secrets (never commit) ----------
.env
*.key
kaggle.json

# ---------- Editors ----------
.vscode/
.idea/

# ---------- OS clutter ----------
Thumbs.db
desktop.ini
.DS_Store
